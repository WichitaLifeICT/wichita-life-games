    return;
  }

  // ---- obstacles: all share a dark red-brown outline so danger reads instantly ----
  const OB = '#4a1f1f';
  if (e.kind === 'rock'){
    // irregular boulder profile
    const R = [[-8,4],[-7,6],[-6,8],[-5,9],[-4,9],[-3,9],[-2,9],[-1,8],
               [0,9],[1,9],[2,8],[3,7],[4,6],[5,4]];
    R.forEach(([dy,hw]) => px(x-hw-1, y+dy, (hw+1)*2, 1, OB));
    R.forEach(([dy,hw]) => px(x-hw,   y+dy,  hw*2,    1, '#8f959c'));
    R.slice(0,5).forEach(([dy,hw]) => px(x-hw+1, y+dy, hw, 1, '#b3b8be'));
    px(x+2,y-3,5,6,'#6a6f76'); px(x-6,y+2,4,3,'#6a6f76');
    px(x-4,y-6,3,2,'#c6cbd0');
  }
  if (e.kind === 'log'){
    outline(x-19,y-7,38,14,OB); px(x-19,y-7,38,14,C.wood);
    px(x-19,y-7,38,3,'#c08b4e'); px(x-19,y+4,38,3,C.woodDark);
    px(x+13,y-5,6,10,'#8d6236'); px(x+15,y-2,2,4,'#5f3f1e');
  }
  if (e.kind === 'branch'){
    // driftwood: light enough to see, with forks breaking the outline
    outline(x-13,y-3,26,6,OB); px(x-13,y-3,26,6,'#b08a5c');
    px(x-13,y-3,26,2,'#cfa877');                   // lit top edge
    px(x-13,y+1,26,2,'#8a6a42');
    outline(x-7,y-10,4,8,OB); px(x-7,y-10,4,8,'#b08a5c');   // fork up
    outline(x+4,y+2,4,8,OB); px(x+4,y+2,4,8,'#9a7a4e');     // fork down
