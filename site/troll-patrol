    outline(x-10,y-14,20,28,OB); px(x-10,y-14,20,28,'#cdd2d8');
    px(x-10,y-14,20,3,'#eaeef2');                  // lit top
    px(x+5,y-14,5,28,'#a9aeb5');                   // shaded side
    px(x-10,y-14,2,28,'#e2e6ea');
    px(x-6,y-9,12,1,'#9aa0a8'); px(x-6,y-2,12,1,'#9aa0a8');   // form lines
    px(x-10,y+8,20,4,'#6f7a83');                   // waterline stain
    px(x-10,y+12,20,2,'#4e5a63');
    px(x-3,y-6,3,3,'#9aa0a8');                     // bolt plate
  }
  if (e.kind === 'goose'){
    const flap = Math.sin(State.t*14) > 0;
    const dir = e.vx >= 0 ? 1 : -1;                  // face the way it's crossing
    const bx = x - dir*3;
    // body
    outline(bx-8,y-3,16,8,OB); px(bx-8,y-3,16,8,'#e8e6dc');
    px(bx-8,y+2,16,3,'#b9b7ad');                     // underside shade
    px(bx-8*dir,y-2,4,3,'#cfcdc3');                  // tail
    // long neck, the thing that says 'goose'
    const nx2 = x + dir*4;
    px(nx2-1, y-11, 3, 9, OB); px(nx2-1+ (dir>0?1:0), y-10, 2, 8, '#25282d');
    // head + beak
    px(nx2-2, y-15, 6, 5, OB); px(nx2-1, y-14, 4, 3, '#25282d');
    px(nx2 + dir*3, y-13, 3, 2, '#e8952c');          // orange beak
    px(nx2 - dir, y-13, 2, 2, '#f6f6f0');            // white cheek patch
    px(nx2 + (dir>0?1:0), y-14, 1, 1, '#ffffff');    // eye
    // wing
    px(bx-6, y + (flap ? -8 : -3), 11, 5, flap ? '#f6f6f0' : '#d6d4ca');
    outline(bx-6, y + (flap ? -8 : -3), 11, 5, OB);
    return;
  }
  if (e.kind === 'racer'){
    /* A rival bathtub. Reusing the player's silhouette in avocado green makes
       it instantly readable as "another one of those" — and it's the joke. */
    const AV = '#8a9e42', AVL = '#a8bc5e', AVD = '#5f7030';
    const R = [[-7,7],[-6,9],[-5,11],[-4,12],[-3,12],[-2,12],[-1,11],
