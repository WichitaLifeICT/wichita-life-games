function render(){
  g.imageSmoothingEnabled = false;

  if (State.mode === 'menu'){ drawMenu(); }
  else {
    drawRiver();
    drawSkyline();
    // bridges drift by as scenery
    const bY = ((State.scroll * 0.5) % 420) - 60;
    if (bY > -20 && bY < VH) drawBridge(bY);
    drawDecor();
    State.entities.forEach(drawEntity);
    drawEggs();
    drawTub(Player.x, Player.y, Player.rot, Player.air);
    // particles + floats
    State.particles.forEach(p => { g.globalAlpha = 1 - p.t/p.life; px(p.x,p.y,2,2,p.col); });
    g.globalAlpha = 1;
    State.floats.forEach(f => {
      g.globalAlpha = Math.max(0, 1 - f.t/f.life);
      text(f.text, f.x, f.y, f.col, f.big?11:8, 'center');
    });
    g.globalAlpha = 1;
    drawHUD();
    if (State.mode === 'count') drawCountdown();
    if (State.mode === 'over')  drawOver();
    if (State.immune > 0 && Math.floor(State.t*16)%2===0){
      g.globalAlpha = 0.25; px(0,0,VW,VH,'#dc5b5e'); g.globalAlpha = 1;
    }
  }
  if (State.flash > 0){ g.globalAlpha = State.flash; px(0,0,VW,VH,'#ffffff'); g.globalAlpha = 1; }

  // blit the world, then lay crisp type over the top
  const sx = State.shake > 0 ? rnd(-2,2) : 0;
  const sy = State.shake > 0 ? rnd(-2,2) : 0;
  ctx.fillStyle = '#0d1826';
  ctx.fillRect(0,0,VW*scale,VH*scale);
  ctx.imageSmoothingEnabled = false;
  ctx.drawImage(buf, sx*scale, sy*scale, VW*scale, VH*scale);
  flushText(sx, sy);
}

/* --------------------------------- LOOP ----------------------------------- */
let rafId = null;
function frame(ts){
  rafId = requestAnimationFrame(frame);
  if (!State.last) State.last = ts;
  let dt = (ts - State.last) / 1000;
  State.last = ts;
  if (State.paused) return;
  dt = Math.min(dt, 0.05);              // clamp after tab switches
  update(dt);
  render();
}
document.addEventListener('visibilitychange', () => {
  State.paused = document.hidden;
  State.last = 0;
  if (document.hidden) Sound.stopMusic();
  else if (State.mode === 'play') Sound.startMusic();
});
seedDecor();
rafId = requestAnimationFrame(frame);
</script>
</body>
