    // rim + murky water
    px(x-8, y-8, 16, 2, AVL); px(x-9, y-7, 18, 1, OB);
    px(x-8, y-6, 16, 3, '#5d7a52'); px(x-6, y-5, 11, 1, '#7fa876');   // murky water
