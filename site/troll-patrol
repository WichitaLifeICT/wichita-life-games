/* --------------------------------- HUD ------------------------------------ */
/* Type is collected in buffer space and rendered at native device resolution
   once the world has been blitted — see flushText(). Drawing it into the 150px
   buffer and scaling it up is what made it fuzzy. */
let textQueue = [];
function text(str, x, y, col, size, align){
  textQueue.push({ str:String(str), x:x, y:y, col:col||'#fff',
                   size:size||8, align:align||'left', alpha:g.globalAlpha });
}
function flushText(offX, offY){
  const shadow = Math.max(1, Math.round(scale * 0.45));
  for (const t of textQueue){
    ctx.save();
    ctx.globalAlpha = t.alpha;
    ctx.font = (t.size * scale) + 'px "Press Start 2P", monospace';
    ctx.textAlign = t.align;
    ctx.textBaseline = 'top';
    const X = (t.x + offX) * scale, Y = (t.y + offY) * scale;
    ctx.fillStyle = 'rgba(8,20,32,0.8)';
    ctx.fillText(t.str, X + shadow, Y + shadow);
    ctx.fillStyle = t.col;
    ctx.fillText(t.str, X, Y);
    ctx.restore();
  }
  textQueue.length = 0;
}
function drawHUD(){
  px(0,0,VW,24,'#152742');
  px(0,24,VW,2,'#0b1726');
  const maxCombo = State.combo >= CFG.COMBO_MAX;
  const pulse = maxCombo && Math.floor(State.t*8)%2===0;
  if (pulse){ px(0,0,VW,24,'#24405f'); }

  text('SCORE', 5, 4, '#8fc0e8', 6);
  text(String(State.score).padStart(6,'0'), 5, 13, '#fff', 8);

  const secs = Math.ceil(State.timeLeft);
  const timeCol = State.clockFlash > 0 && Math.floor(State.t*14)%2===0 ? '#7fd3f2'
                : State.rush ? (Math.floor(State.t*8)%2===0 ? '#ff8b8e' : '#dc5b5e') : '#fff';
  text('TIME', VW/2, 4, '#8fc0e8', 6, 'center');
  text('0:' + String(secs).padStart(2,'0'), VW/2, 13, timeCol, 8, 'center');

  text('COMBO', VW-5, 4, '#8fc0e8', 6, 'right');
  text('x' + State.combo, VW-5, 13, maxCombo ? '#fcc172' : '#fff', 8, 'right');

  let banner = null, bcol = null;
  if (State.rush)          { banner = 'RIVER RUSH'; bcol = '#dc5b5e'; }
  else if (State.turbo > 0){ banner = 'TUB TURBO';  bcol = '#3f9e5c'; }
  if (banner){
    px(0,26,VW,12,bcol);
    text(banner, VW/2, 29, '#fff', 7, 'center');
  }
  if (Sound.isMuted()) text('MUTED', 5, 40, '#6f8199', 6);
}

