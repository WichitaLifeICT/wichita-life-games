<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Troll Patrol — Wichita Life Games</title>
<meta name="theme-color" content="#152742">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
:root{ --navy:#152742; --red:#dc5b5e; --yellow:#fcc172; --blue:#3c67b1; --paper:#fbf7ef; }
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0;height:100%;overflow:hidden;background:#0d1826}
body{
  font-family:'Press Start 2P',ui-monospace,Menlo,Consolas,monospace;
  color:var(--paper); display:flex; align-items:center; justify-content:center;
  touch-action:none; user-select:none;
}
#wrap{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding-top:26px}
canvas{
  display:block; image-rendering:pixelated; image-rendering:crisp-edges;
  background:#3d7a4f; touch-action:none;
}
#hint{display:none}
</style>
</head>
<body>
<div id="wrap"><canvas id="c"></canvas></div>
<div id="hint">arrows / wasd &nbsp;·&nbsp; drag to steer &nbsp;·&nbsp; M mutes</div>

<script>
window.WL_SCORE_ENV = 'live';
'use strict';
/* ============================================================================
   TROLL PATROL — Wichita Life Games
   Single-file canvas game. Renders to a small virtual buffer (VW x VH) which is
   scaled up with smoothing off, which is what keeps the pixel art crisp at any
   screen size and keeps fill-rate cheap on phones.
   ========================================================================== */

/* ------------------------------- CONFIG ---------------------------------- */
const CFG = {
  ROUND_DURATION:      30,     // seconds
  TRASH_SPAWN_RATE:    1.05,   // spawns per second, base
  OBSTACLE_SPAWN_RATE: 0.62,
  COMBO_TIMEOUT:       2.0,    // seconds without a pickup before combo resets
  COMBO_MAX:           5,
  TURBO_DURATION:      3.0,
  RIVER_SPEED:         58,     // virtual px/sec, base
  RIVER_RUSH_AT:       5,      // seconds remaining when Rush begins
  RIVER_RUSH_MULT:     1.55,   // speed multiplier during Rush
  TURBO_SPEED_MULT:    1.8,
  AIR_TIME:            1.0,    // seconds airborne off a ramp
  BONK_PENALTY:        2,      // seconds lost
  TIME_BONUS:          2,      // seconds a baseball hands back
  BALL_EVERY:          [9,15], // seconds between baseballs
  IMMUNITY:            1.0,    // seconds of collision immunity after a bonk
  // Top speed is really STEER_ACCEL / STEER_DRAG (about 129 px/s here); the cap
  // below only bites during a boost. Raise ACCEL for quicker darting, raise DRAG
  // for less slide.
  STEER_ACCEL:         1100,   // responsiveness
  STEER_DRAG:          8.5,    // higher = less slide
  MAX_STEER_SPEED:     170,
};

const POINTS = { can:10, bottle:10, cup:15, boot:25, tire:50, bag:100, button:250, landing:50, ball:25 };

/* Virtual resolution. Portrait-ish, works on both. */
const VW = 150, VH = 266;        // smaller buffer => bigger sprites on screen
const BANK = 16;                  // narrower banks = wider play area                 // riverbank width each side
const RIVER_L = BANK, RIVER_R = VW - BANK;

/* ------------------------------- CANVAS ---------------------------------- */
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d', { alpha:false });
const buf = document.createElement('canvas');
buf.width = VW; buf.height = VH;
const g = buf.getContext('2d', { alpha:false });
g.imageSmoothingEnabled = false;

let scale = 1;
function resize(){
  // Fill the screen rather than snapping down to whole-number scales. Integer
  // scaling looks marginally cleaner but wasted up to half the viewport on
  // smaller phones; image-rendering:pixelated keeps edges hard either way.
  const bar = document.getElementById('devbar');
  const barH = bar ? bar.offsetHeight : 0;
  const pad = 8;
  const availW = window.innerWidth - pad;
  const availH = window.innerHeight - barH - pad;
  scale = Math.min(availW / VW, availH / VH);
  // Whole-number scales keep world pixels perfectly square. Take one whenever
  // it costs less than 12% of the size — the crispness is worth more.
  const down = Math.floor(scale);
  if (down >= 1 && down / scale > 0.88) scale = down;
  scale = Math.max(1, scale);
  const dpr = Math.min(window.devicePixelRatio || 1, 3);
  canvas.width  = VW * scale * dpr;
  canvas.height = VH * scale * dpr;
  canvas.style.width  = (VW * scale) + 'px';
  canvas.style.height = (VH * scale) + 'px';
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.imageSmoothingEnabled = false;
}
window.addEventListener('resize', resize);
window.addEventListener('orientationchange', ()=>setTimeout(resize,120));
resize();

/* -------------------------------- AUDIO ---------------------------------- */
const Sound = (() => {
  let actx = null, muted = false, musicGain = null, musicTimer = null, step = 0;
  function ready(){
    if (!actx) { try { actx = new (window.AudioContext||window.webkitAudioContext)(); } catch(e){ return null; } }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  function blip(freq, dur, type, vol, slideTo){
    const a = ready(); if (!a || muted) return;
    const o = a.createOscillator(), gn = a.createGain();
    o.type = type || 'square';
    o.frequency.setValueAtTime(freq, a.currentTime);
    if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, a.currentTime + dur);
    gn.gain.setValueAtTime(vol == null ? 0.16 : vol, a.currentTime);
    gn.gain.exponentialRampToValueAtTime(0.0008, a.currentTime + dur);
    o.connect(gn); gn.connect(a.destination);
    o.start(); o.stop(a.currentTime + dur + 0.02);
  }
  function noise(dur, vol){
    const a = ready(); if (!a || muted) return;
    const n = Math.floor(a.sampleRate * dur);
    const b = a.createBuffer(1, n, a.sampleRate), d = b.getChannelData(0);
    for (let i=0;i<n;i++) d[i] = (Math.random()*2-1) * (1 - i/n);
    const src = a.createBufferSource(), gn = a.createGain();
    src.buffer = b; gn.gain.value = vol == null ? 0.12 : vol;
    src.connect(gn); gn.connect(a.destination); src.start();
  }
  // simple original chiptune bass line, tempo scales with the river
  const NOTES = [147,147,196,165,131,131,175,147];
  function startMusic(){
    stopMusic();
    const tick = () => {
      if (!muted && State.mode === 'play'){
        blip(NOTES[step % NOTES.length], 0.11, 'triangle', 0.05);
        if (step % 4 === 0) noise(0.03, 0.03);
      }
      step++;
      musicTimer = setTimeout(tick, State.rush ? 150 : 200);
    };
    tick();
  }
  function stopMusic(){ if (musicTimer) clearTimeout(musicTimer); musicTimer = null; }
  return {
    pickup(c){ blip(520 + c*90, 0.07, 'square', 0.13); },
    combo(c){ blip(400 + c*120, 0.12, 'square', 0.15, 700 + c*140); },
    ramp(){ blip(300, 0.28, 'sawtooth', 0.14, 900); },
    splash(){ noise(0.22, 0.14); },
    bonk(){ blip(180, 0.22, 'sawtooth', 0.2, 70); noise(0.16, 0.12); },
    turbo(){ blip(260, 0.45, 'sawtooth', 0.16, 1100); },
    ball(){ blip(660, 0.1, 'square', 0.15, 990); setTimeout(()=>blip(990, 0.14, 'square', 0.14, 1320), 80); },
    rare(){ [0,90,180,270].forEach((d,i)=>setTimeout(()=>blip(600+i*220, 0.13, 'square', 0.16), d)); },
    warn(){ blip(880, 0.16, 'square', 0.18); setTimeout(()=>blip(1180,0.2,'square',0.18),170); },
    over(){ [440,330,262,196].forEach((f,i)=>setTimeout(()=>blip(f,0.22,'triangle',0.16), i*130)); },
    count(hi){ blip(hi?900:600, 0.14, 'square', 0.16); },
    toggle(){ muted = !muted; if (muted) stopMusic(); else if (State.mode==='play') startMusic(); return muted; },
    isMuted(){ return muted; },
    startMusic, stopMusic, ready,
  };
})();

/* ----------------------------- LEADERBOARD --------------------------------
   Scores go through a signed round token from /api/round: the server refuses
   anything that didn't sit for a full round. localStorage keeps your personal
   best and doubles as the fallback when the network is down. */
const Leaderboard = (() => {
  const KEY='trollpatrol.scores.v1', GAME='troll-patrol';
  const ENV = window.WL_SCORE_ENV || 'dev';
  const BASE = (window.WL_ANALYTICS_ENDPOINT || '/api/event').replace(/\/event$/, '');
  const cache={today:null,week:null,all:null};
  let state='idle', token=null, summary={};

  function local(){ try{ return JSON.parse(localStorage.getItem(KEY))||[]; }catch(e){ return []; } }
  function save(l){ try{ localStorage.setItem(KEY, JSON.stringify(l.slice(0,20))); }catch(e){} }

  async function newToken(){
    if(typeof fetch!=='function') return;
    try{
      const r=await fetch(BASE+'/round',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({game:GAME})});
      const d=await r.json(); token=d.token||null;
    }catch(e){ token=null; }
  }
  async function post(body){
    if(typeof fetch!=='function' || !token) return null;
    try{
      const r=await fetch(BASE+'/score',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify(Object.assign({token,env:ENV,
          visitor_id:(window.WLGames&&WLGames.visitorId&&WLGames.visitorId())||null,
          device:/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)?'mobile':'desktop'}, body))});
      return await r.json();
    }catch(e){ return null; }
  }
  async function fetchBoard(tab){
    if(typeof fetch!=='function'){ state='offline'; return; }
    state='loading';
    try{
      const r=await fetch(BASE+'/score?game='+GAME+'&env='+ENV+'&tab='+tab);
      const d=await r.json();
      cache[tab]=(d.rows||[]).map(x=>({name:x.name,score:Number(x.score)}));
      summary=d.summary||{};
      state=d.unavailable?'offline':'ready';
    }catch(e){ state='offline'; }
  }

  return {
    best(){ const l=local(); return l.length?l[0].score:0; },
    state(){ return state; },
    summary(){ return summary; },
    startRound(){ newToken(); },
    load(tab){ if(cache[tab]===null) fetchBoard(tab); },
    // every finished round is recorded, listed or not — that's what the stats count
    recordRound(stats){ post(Object.assign({listed:false}, stats)); },
    async submit(name, score, stats){
      const l=local(); l.push({name,score,at:Date.now()}); l.sort((a,b)=>b.score-a.score); save(l);
      await post(Object.assign({name:name, score:score, listed:true}, stats||{}));
      Object.keys(cache).forEach(k=>cache[k]=null);
      fetchBoard('today');
    },
    board(tab){
      if(cache[tab]) return cache[tab].slice(0,6);
      return local().slice(0,6).map(e=>({name:e.name,score:e.score,mine:true}));
    },
  };
})();

/* ------------------------------- HELPERS ---------------------------------- */
const rnd  = (a,b) => a + Math.random()*(b-a);
const rndi = (a,b) => Math.floor(rnd(a,b+1));
const pick = arr => arr[Math.floor(Math.random()*arr.length)];
const clamp = (v,a,b) => v<a?a:(v>b?b:v);

function px(x,y,w,h,col){ g.fillStyle = col; g.fillRect(x|0, y|0, w|0, h|0); }

/* --------------------------------- STATE ---------------------------------- */
const State = {
  mode:'menu',            // menu | count | play | over | board
  t:0, last:0, acc:0,
  timeLeft: CFG.ROUND_DURATION,
  scroll: 0,
  score: 0, combo: 1, comboTimer: 0, bestCombo: 1,
  trashCount: 0, rampsHit: 0, buttons: 0,
  rush: false, shake: 0, flash: 0,
  turbo: 0, immune: 0,
  countdown: 3, countTimer: 0,
  entities: [], floats: [], particles: [], decor: [], eggs: [],
  spawnT: 0, obsT: 0, decorT: 0, boostT: 8, buttonT: 12, eggT: 5, ballT: 7,
  balls: 0, secondsGained: 0, clockFlash: 0,
  boardTab: 'today',
  initials: ['A','A','A'], initialIdx: 0, pendingScore: 0, newBest: false,
  paused: false,
};

const Player = {
  x: VW/2, y: VH - 66, vx: 0, vy: 0,
  air: 0, airTotal: 0, rot: 0, tilt: 0,
  w: 32, h: 20,
};

/* --------------------------------- INPUT ---------------------------------- */
const keys = {};
let dragging = false, dragX = 0, dragY = 0, targetX = null, targetY = null;

window.addEventListener('keydown', e => {
  if (['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' '].includes(e.key)) e.preventDefault();
  keys[e.key.toLowerCase()] = true;
  if (e.key.toLowerCase() === 'm') Sound.toggle();
  if (State.mode === 'menu' && (e.key === ' ' || e.key === 'Enter')) startGame();
  else if (State.mode === 'over' && (e.key === ' ' || e.key === 'Enter')) startGame();
  else if (State.mode === 'over') handleInitialsKey(e);
}, { passive:false });
window.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });

function canvasPos(ev){
  const r = canvas.getBoundingClientRect();
  const p = ev.touches ? ev.touches[0] : ev;
  return { x: (p.clientX - r.left) / scale, y: (p.clientY - r.top) / scale };
}
function down(ev){
  ev.preventDefault();
  const p = canvasPos(ev);
  Sound.ready();
  if (State.mode === 'menu') { startGame(); return; }
  if (State.mode === 'over') { handleOverTap(p); return; }
  dragging = true; dragX = p.x; dragY = p.y; targetX = Player.x; targetY = Player.y;
}
function move(ev){
  if (!dragging) return;
  ev.preventDefault();
  const p = canvasPos(ev);
  targetX = clamp(targetX + (p.x - dragX), RIVER_L+16, RIVER_R-16);
  targetY = clamp(targetY + (p.y - dragY), VH*0.40, VH-30);
  dragX = p.x; dragY = p.y;
}
function up(){ dragging = false; targetX = null; targetY = null; }
canvas.addEventListener('touchstart', down, { passive:false });
canvas.addEventListener('touchmove',  move, { passive:false });
canvas.addEventListener('touchend',   up);
canvas.addEventListener('mousedown',  down);
window.addEventListener('mousemove',  move);
window.addEventListener('mouseup',    up);

/* ------------------------------ GAME CONTROL ------------------------------ */
function resetRound(){
  State.timeLeft = CFG.ROUND_DURATION;
  State.score = 0; State.combo = 1; State.comboTimer = 0; State.bestCombo = 1;
  State.trashCount = 0; State.rampsHit = 0; State.buttons = 0;
  State.balls = 0; State.secondsGained = 0; State.clockFlash = 0;
  State.rush = false; State.shake = 0; State.flash = 0;
  State.turbo = 0; State.immune = 0; State.scroll = 0;
  State.entities.length = 0; State.floats.length = 0;
  State.particles.length = 0; State.eggs.length = 0;
  State.spawnT = 0.6; State.obsT = 1.6; State.boostT = rnd(7,11);
  State.buttonT = rnd(11,19); State.eggT = rnd(4,9); State.ballT = rnd(5,9);
  Player.x = VW/2; Player.y = VH - 66; Player.vx = 0; Player.vy = 0;
  Player.air = 0; Player.rot = 0; Player.tilt = 0;
  if (!State.decor.length) seedDecor();
}
function startGame(){
  Sound.ready();
  Leaderboard.startRound();
  resetRound();
  State.mode = 'count'; State.countdown = 3; State.countTimer = 0;
}
/* everything worth knowing about a finished round */
function roundStats(){
  return { score:State.score, trash:State.trashCount, best_combo:State.bestCombo,
           ramps:State.rampsHit, bonuses:State.buttons,
           balls:State.balls, seconds_gained:Math.round(State.secondsGained) };
}
function endRound(){
  State.mode = 'over';
  Leaderboard.recordRound(roundStats());
  Leaderboard.load('today');
  Sound.stopMusic(); Sound.over();
  State.pendingScore = State.score;
  State.newBest = State.score > Leaderboard.best();
  State.initials = ['A','A','A']; State.initialIdx = 0;
  State.submitted = false;
}

/* -------------------------------- SPAWNING -------------------------------- */
const TRASH_KINDS = [
  { k:'can',    p:26, w:11, h:13 },
  { k:'bottle', p:26, w:10, h:15 },
  { k:'cup',    p:20, w:12, h:14 },
  { k:'boot',   p:14, w:15, h:12 },
  { k:'tire',   p:9,  w:17, h:17 },
  { k:'bag',    p:5,  w:16, h:16 },
];
function rollTrash(){
  let total = TRASH_KINDS.reduce((a,t)=>a+t.p,0), r = Math.random()*total;
  for (const t of TRASH_KINDS){ if ((r -= t.p) <= 0) return t; }
  return TRASH_KINDS[0];
}
const OBSTACLES = ['rock','log','branch','pier','goose','racer'];

/* Keep a gap the player can always steer through: never place a new object
   within GAP px of another spawned in the same band. */
function freeX(w){
  for (let tries=0; tries<12; tries++){
    const x = rnd(RIVER_L + w, RIVER_R - w);
    let ok = true;
    for (const e of State.entities){
      if (e.y > -46 && Math.abs(e.x - x) < 34) { ok = false; break; }
    }
    if (ok) return x;
  }
  return rnd(RIVER_L + w, RIVER_R - w);
}
function spawnTrash(){
  const t = rollTrash();
  State.entities.push({ type:'trash', kind:t.k, x:freeX(t.w), y:-14, w:t.w, h:t.h, spin:rnd(-1,1), t:0 });
}
function spawnObstacle(){
  const kind = pick(OBSTACLES);
  const size = { rock:[18,15], log:[38,14], branch:[26,10], pier:[20,26], goose:[18,15], racer:[30,19] }[kind];
  const e = { type:'obs', kind, x:freeX(size[0]), y:-24, w:size[0], h:size[1], t:0 };
  if (kind === 'goose'){ e.vx = pick([-30,30]); e.x = e.vx > 0 ? RIVER_L+4 : RIVER_R-4; }
  if (kind === 'racer'){ e.vx = rnd(-14,14); }
  State.entities.push(e);
}
function spawnRamp(){
  State.entities.push({ type:'ramp', x:freeX(28), y:-20, w:28, h:18, t:0 });
}
function spawnBoost(){
  State.entities.push({ type:'boost', x:freeX(16), y:-16, w:16, h:16, t:0 });
}
function spawnBall(){
  State.entities.push({ type:'ball', x:freeX(13), y:-14, w:13, h:13, t:0 });
}
function spawnButton(){
  State.entities.push({ type:'button', x:freeX(16), y:-16, w:16, h:16, t:0 });
}
function seedDecor(){
  State.decor.length = 0;
  for (let i=0;i<26;i++){
    State.decor.push({
      side: i%2, y: rnd(-VH, VH), kind: pick(['tree','tree','tree','lamp','bush','path']),
      x: rnd(2, BANK-8),
    });
  }
}

/* ------------------------------- FLOATERS --------------------------------- */
function addFloat(text, x, y, col, big){
  State.floats.push({ text, x, y, col: col||'#fff', t:0, life: big?1.4:0.9, big:!!big });
}
function burst(x,y,col,n){
  for (let i=0;i<(n||8);i++){
    State.particles.push({ x, y, vx:rnd(-40,40), vy:rnd(-50,10), t:0, life:rnd(0.3,0.7), col });
  }
}

/* -------------------------------- SCORING --------------------------------- */
function multiplier(airborne){
  let m = State.combo;
  if (airborne) m *= 2;
  if (State.turbo > 0) m *= 2;
  if (State.rush) m *= 2;
  return m;
}
function collect(e){
  const airborne = Player.air > 0;
  const base = POINTS[e.kind] || 10;
  const mult = multiplier(airborne);
  const gained = base * mult;
  State.score += gained;
  State.trashCount++;

  if (State.combo < CFG.COMBO_MAX && State.comboTimer > 0){
    State.combo++; Sound.combo(State.combo);
    if (State.combo > State.bestCombo) State.bestCombo = State.combo;
  } else Sound.pickup(State.combo);
  State.comboTimer = CFG.COMBO_TIMEOUT;

  addFloat('+' + gained, e.x, e.y, mult >= 4 ? '#fcc172' : '#fff');
  burst(e.x, e.y, '#cfe6ff', 6);
  Player.tilt = e.x < Player.x ? -1 : 1;
}

/* -------------------------------- UPDATE ---------------------------------- */
function update(dt){
  State.t += dt;

  if (State.mode === 'count'){
    State.countTimer += dt;
    if (State.countTimer >= 0.75){
      State.countTimer = 0; State.countdown--;
      if (State.countdown >= 0) Sound.count(State.countdown === 0);
      if (State.countdown < 0){ State.mode = 'play'; Sound.startMusic(); }
    }
    return;
  }
  if (State.mode !== 'play') { updateFX(dt); return; }

  /* timer */
  const wasRush = State.rush;
  State.timeLeft -= dt;
  State.rush = State.timeLeft <= CFG.RIVER_RUSH_AT && State.timeLeft > 0;
  if (State.rush && !wasRush){ Sound.warn(); addFloat('RIVER RUSH!', VW/2, VH*0.36, '#dc5b5e', true); State.shake = 0.4; }
  if (State.timeLeft <= 0){ State.timeLeft = 0; endRound(); return; }

  /* speed */
  let speed = CFG.RIVER_SPEED;
  if (State.rush)     speed *= CFG.RIVER_RUSH_MULT;
  if (State.turbo > 0) speed *= CFG.TURBO_SPEED_MULT;
  const elapsed = CFG.ROUND_DURATION - State.timeLeft;
  speed *= 1 + Math.min(0.28, elapsed / CFG.ROUND_DURATION * 0.28);   // gentle ramp
  State.scroll += speed * dt;

  /* steering */
  let ax = 0, ay = 0;
  if (keys['arrowleft']  || keys['a']) ax -= 1;
  if (keys['arrowright'] || keys['d']) ax += 1;
  if (keys['arrowup']    || keys['w']) ay -= 1;
  if (keys['arrowdown']  || keys['s']) ay += 1;
  if (targetX != null){
    ax = clamp((targetX - Player.x) / 6, -1, 1);
    ay = clamp((targetY - Player.y) / 8, -1, 1);
  }
  Player.vx += ax * CFG.STEER_ACCEL * dt;
  Player.vy += ay * CFG.STEER_ACCEL * 0.55 * dt;   // vertical deliberately calmer
  Player.vx -= Player.vx * CFG.STEER_DRAG * dt;
  Player.vy -= Player.vy * CFG.STEER_DRAG * dt;
  Player.vx = clamp(Player.vx, -CFG.MAX_STEER_SPEED, CFG.MAX_STEER_SPEED);
  Player.vy = clamp(Player.vy, -CFG.MAX_STEER_SPEED, CFG.MAX_STEER_SPEED);
  Player.x = clamp(Player.x + Player.vx*dt, RIVER_L+16, RIVER_R-16);
  Player.y = clamp(Player.y + Player.vy*dt, VH*0.40, VH-30);
  Player.tilt += (clamp(Player.vx/70, -1, 1) - Player.tilt) * Math.min(1, dt*8);

  /* air */
  if (Player.air > 0){
    Player.air -= dt;
    Player.rot += dt * 6;
    if (Player.air <= 0){
      Player.air = 0; Player.rot = 0;
      Sound.splash(); burst(Player.x, Player.y+6, '#bfe3ff', 12);
      State.score += POINTS.landing;
      addFloat('+' + POINTS.landing, Player.x, Player.y - 14, '#8ee6a0');
    }
  }
  if (State.turbo > 0) State.turbo -= dt;
  if (State.immune > 0) State.immune -= dt;

  /* combo decay */
  if (State.comboTimer > 0){
    State.comboTimer -= dt;
    if (State.comboTimer <= 0 && State.combo > 1) State.combo = 1;
  }

  /* spawns */
  const dens = (State.rush ? 2.0 : 1) * (State.turbo > 0 ? 1.5 : 1)
             * (elapsed < 10 ? 0.8 : elapsed < 20 ? 1.05 : 1.3);
  State.spawnT -= dt * CFG.TRASH_SPAWN_RATE * dens;
  if (State.spawnT <= 0){ spawnTrash(); State.spawnT = rnd(0.7,1.15); if (Math.random()<0.12) spawnTrash(); }
  State.obsT -= dt * CFG.OBSTACLE_SPAWN_RATE * (elapsed < 10 ? 0.55 : dens);
  if (State.obsT <= 0){ (Math.random() < 0.26 ? spawnRamp : spawnObstacle)(); State.obsT = rnd(1.0,1.9); }
  State.boostT -= dt;
  if (State.boostT <= 0){ spawnBoost(); State.boostT = rnd(9,15); }
  State.buttonT -= dt;
  if (State.buttonT <= 0){ spawnButton(); State.buttonT = rnd(16,26); }
  State.ballT -= dt;
  if (State.ballT <= 0){ spawnBall(); State.ballT = rnd(CFG.BALL_EVERY[0], CFG.BALL_EVERY[1]); }
  State.eggT -= dt;
  if (State.eggT <= 0){ maybeEasterEgg(); State.eggT = rnd(6,13); }

  /* entities */
  for (let i=State.entities.length-1; i>=0; i--){
    const e = State.entities[i];
    e.t += dt;
    e.y += speed * dt;
    if (e.vx){
      e.x += e.vx * dt;
      if (e.kind === 'goose' && (e.x < RIVER_L+3 || e.x > RIVER_R-3)) e.vx *= -1;
      if (e.kind === 'racer'){
        if (e.x < RIVER_L+12 || e.x > RIVER_R-12) e.vx *= -1;
      }
    }
    if (e.y > VH + 30){ State.entities.splice(i,1); continue; }

    const dx = Math.abs(e.x - Player.x), dy = Math.abs(e.y - Player.y);
    const hit = dx < (e.w/2 + Player.w/2 - 3) && dy < (e.h/2 + Player.h/2 - 3);
    if (!hit) continue;

    if (e.type === 'trash'){ collect(e); State.entities.splice(i,1); }
    else if (e.type === 'button'){
      State.score += POINTS.button * multiplier(Player.air>0);
      State.buttons++; State.flash = 0.35; Sound.rare();
      addFloat('RIVERFEST!', VW/2, VH*0.4, '#fcc172', true);
      addFloat('+' + POINTS.button*multiplier(Player.air>0), e.x, e.y, '#fcc172');
      burst(e.x, e.y, '#fcc172', 18);
      State.entities.splice(i,1);
    }
    else if (e.type === 'ball'){
      // a baseball out of the river — Equity Bank Park (the old Riverfront
      // Stadium) sits on the west bank in Delano, so this is barely a stretch
      const room  = Math.max(0, CFG.ROUND_DURATION - State.timeLeft);  // never bank past a full round
      const given = Math.min(CFG.TIME_BONUS, room);
      State.timeLeft += given; State.secondsGained += given; State.balls++;
      const pts = POINTS.ball * multiplier(Player.air > 0);
      State.score += pts;
      Sound.ball();
      addFloat(given >= 1 ? '+' + Math.round(given) + ' SEC' : 'CLOCK FULL', VW/2, 44, '#7fd3f2', true);
      addFloat('+' + pts, e.x, e.y, '#fff');
      burst(e.x, e.y, '#e8f4ff', 12);
      State.clockFlash = 0.7;
      State.entities.splice(i,1);
    }
    else if (e.type === 'boost'){
      State.turbo = CFG.TURBO_DURATION; State.shake = 0.35; Sound.turbo();
      addFloat('TUB TURBO!', VW/2, VH*0.42, '#8ee6a0', true);
      burst(e.x, e.y, '#8ee6a0', 14);
      State.entities.splice(i,1);
    }
    else if (e.type === 'ramp'){
      if (Player.air <= 0){
        Player.air = CFG.AIR_TIME; Player.airTotal = CFG.AIR_TIME;
        State.rampsHit++; Sound.ramp();
        addFloat('BIG AIR!', Player.x, Player.y - 22, '#fcc172', true);
      }
      State.entities.splice(i,1);
    }
    else if (e.type === 'obs'){
      if (Player.air > 0) continue;                 // sail over obstacles
      if (State.immune > 0) continue;
      State.immune = CFG.IMMUNITY;
      State.timeLeft = Math.max(0, State.timeLeft - CFG.BONK_PENALTY);
      State.combo = 1; State.comboTimer = 0;
      State.shake = 0.35; Sound.bonk();
      Player.vx = (Player.x < e.x ? -1 : 1) * 90;
      Player.rot = 0.6;
      addFloat('BONK!', Player.x, Player.y - 18, '#dc5b5e', true);
      addFloat('-2 SEC', Player.x, Player.y - 6, '#dc5b5e');
      burst(Player.x, Player.y, '#bfe3ff', 12);
      State.entities.splice(i,1);
    }
  }

  if (Player.rot > 0 && Player.air <= 0) Player.rot = Math.max(0, Player.rot - dt*1.6);
  updateFX(dt);
}

function updateFX(dt){
  for (let i=State.floats.length-1;i>=0;i--){
    const f = State.floats[i];
    f.t += dt; f.y -= dt * 16;
    if (f.t > f.life) State.floats.splice(i,1);
  }
  for (let i=State.particles.length-1;i>=0;i--){
    const p = State.particles[i];
    p.t += dt; p.x += p.vx*dt; p.y += p.vy*dt; p.vy += 120*dt;
    if (p.t > p.life) State.particles.splice(i,1);
  }
  for (let i=State.eggs.length-1;i>=0;i--){
    const e = State.eggs[i];
    e.t += dt; e.x += (e.vx||0)*dt; e.y += (e.vy||0)*dt;
    if (e.t > e.life) State.eggs.splice(i,1);
  }
  if (State.clockFlash > 0) State.clockFlash = Math.max(0, State.clockFlash - dt);
  if (State.shake > 0) State.shake = Math.max(0, State.shake - dt);
  if (State.flash > 0) State.flash = Math.max(0, State.flash - dt);
}

/* ------------------------------ EASTER EGGS ------------------------------- */
function maybeEasterEgg(){
  const r = Math.random();
  if (r < 0.30) State.eggs.push({ kind:'plane', x:-20, y:rnd(18,34), vx:34, life:9, t:0 });
  else if (r < 0.55) State.eggs.push({ kind:'fish', x:rnd(RIVER_L+16,RIVER_R-16), y:rnd(VH*0.5,VH*0.8), life:0.9, t:0 });
  else if (r < 0.72) State.eggs.push({ kind:'chase', x:Player.x - 26, y:Player.y + 16, life:2.6, t:0 });
  else if (r < 0.86) State.eggs.push({ kind:'cyclist', x:rnd(4,BANK-10), y:VH+10, vy:-70, life:6, t:0, side:Math.random()<0.5?0:1 });
  // remaining ~14%: nothing, keeps them rare
}

