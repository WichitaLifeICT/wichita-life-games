    px(x-4,y-4,2,1,'#ffffff');
    // stitches
    px(x-4,y-3,1,2,'#dc5b5e'); px(x-3,y-1,1,2,'#dc5b5e'); px(x-4,y+2,1,2,'#dc5b5e');
    px(x+3,y-3,1,2,'#dc5b5e'); px(x+2,y-1,1,2,'#dc5b5e'); px(x+3,y+2,1,2,'#dc5b5e');
    return;
  }
  if (e.type === 'boost'){
    const p = (Math.sin(State.t*10)+1)/2;
    outline(x-8,y-8,16,16,'#0f4a24');
    px(x-8,y-8,16,16, p>0.5?'#8ee6a0':'#5fd07a');
    px(x-4,y-6,3,12,'#ffffff'); px(x-1,y-2,6,3,'#ffffff'); px(x+1,y-6,3,6,'#ffffff');
    if (p>0.5){ px(x-11,y-2,3,4,'#8ee6a0'); px(x+8,y-2,3,4,'#8ee6a0'); }
    return;
  }
  if (e.type === 'button'){
    const p = Math.floor(State.t*8)%4;
    const cols = ['#dc5b5e','#fcc172','#3c67b1','#8ee6a0'];
    outline(x-8,y-8,16,16,'#2b1b3a');
