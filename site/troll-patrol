function handleInitialsKey(e){
  if (State.submitted) return;
  const k = e.key;
  if (k === 'ArrowUp' || k === 'ArrowDown'){
    const cur = State.initials[State.initialIdx].charCodeAt(0) - 65;
    const next = ((cur + (k==='ArrowUp'?1:-1)) + 26) % 26;
    State.initials[State.initialIdx] = String.fromCharCode(65 + next);
  }
  if (k === 'ArrowRight') State.initialIdx = Math.min(2, State.initialIdx+1);
  if (k === 'ArrowLeft')  State.initialIdx = Math.max(0, State.initialIdx-1);
  if (/^[a-zA-Z]$/.test(k)){
    State.initials[State.initialIdx] = k.toUpperCase();
    State.initialIdx = Math.min(2, State.initialIdx+1);
  }
}
function handleOverTap(p){
  if (p.y >= 236 && p.y <= 260){ startGame(); return; }
  if (!State.submitted){
    for (let i=0;i<3;i++){
      const bx = VW/2 - 33 + i*23;
      if (p.x >= bx && p.x <= bx+20 && p.y >= 160 && p.y <= 184){
        if (State.initialIdx === i){
          const cur = State.initials[i].charCodeAt(0) - 65;
          State.initials[i] = String.fromCharCode(65 + (cur+1)%26);
        } else State.initialIdx = i;
        return;
      }
    }
    if (p.y >= 196 && p.y <= 214 && Math.abs(p.x - VW/2) < 28){
      Leaderboard.submit(State.initials.join(''), State.score, roundStats());
      State.submitted = true;
    }
    return;
  }
  ['today','week','allTime'].forEach((t,i) => {
    const bx = 10 + i*44;
    if (p.x >= bx && p.x <= bx+42 && p.y >= 148 && p.y <= 161) State.boardTab = t;
  });
}

