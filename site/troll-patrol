    const B = [[-6,3],[-5,5],[-4,6],[-3,6],[-2,6],[-1,6],[0,6],[1,6],[2,6],[3,5],[4,4],[5,2]];
    B.forEach(([dy,hw]) => px(x-hw-1, y+dy, (hw+1)*2, 1, '#16323f'));
    B.forEach(([dy,hw]) => px(x-hw,   y+dy,  hw*2,    1, '#f6f6f0'));
