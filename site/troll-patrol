/* Original pixel troll in a bathtub. Drawn from primitives so there are no
   external assets to load. */
/* ---------------------------------------------------------------------------
   The tub is built from a width profile rather than stacked rectangles, so it
   reads as a rounded porcelain bathtub instead of a white box: flared rim at
   the back, tapering body, clawfeet, and a faucet at the near end.
   ------------------------------------------------------------------------- */
function row(cx, y, half, col){ px(cx-half, y, half*2, 1, col); }

// [y offset, half width] from the flared rim down to the base
const TUB_PROFILE = [
  [-11, 11], [-10, 14], [-9, 16], [-8, 17], [-7, 17],
  [-6, 17], [-5, 16], [-4, 16], [-3, 16], [-2, 15],
  [-1, 15], [ 0, 15], [ 1, 14], [ 2, 14], [ 3, 13],
  [ 4, 12], [ 5, 11], [ 6,  9], [ 7,  7],
];
// inner opening — the dark part you'd actually sit in
const TUB_INNER = [
  [-9, 12], [-8, 13], [-7, 13], [-6, 13], [-5, 12], [-4, 11], [-3, 9],
];

function drawTub(x, y, rot, air){
  const shadowY = y + 13 + (air > 0 ? 18 : 0);
  g.globalAlpha = air > 0 ? 0.3 : 0.22;
  px(x-15, shadowY, 30, 4, '#123a4d');
  g.globalAlpha = 1;

  g.save();
  g.translate(x|0, y|0);
  g.rotate(rot * 0.25 + Player.tilt * 0.1);
  g.translate(-(x|0), -(y|0));

  // wake
  if (air <= 0){
    const w = State.turbo > 0 ? 24 : 15;
    g.globalAlpha = 0.6;
    px(x - w/2, y + 12, w, 2, '#d8f0ff');
    px(x - w/3, y + 16, w * 0.62, 2, '#a8d6f2');
    if (State.turbo > 0){ px(x - w/2 - 4, y + 9, 4, 2, '#d8f0ff'); px(x + w/2, y + 9, 4, 2, '#d8f0ff'); }
    g.globalAlpha = 1;
  }

  // 1. dark silhouette one pixel proud on every side — this is what separates
  //    the tub from the river at a glance
  TUB_PROFILE.forEach(([dy, hw]) => row(x, y + dy, hw + 1, '#22303e'));
  row(x, y + 8, 6, '#22303e');

  // 2. porcelain body, lit from the upper left
  TUB_PROFILE.forEach(([dy, hw]) => row(x, y + dy, hw, C.tub));
  TUB_PROFILE.forEach(([dy, hw]) => {           // right-hand shading
    px(x + hw - 4, y + dy, 4, 1, dy > 1 ? '#b9b9b2' : '#d8d8d1');
  });
  TUB_PROFILE.forEach(([dy, hw]) => {           // left highlight
    if (dy < 4) px(x - hw, y + dy, 3, 1, '#ffffff');
  });

  // 3. rolled rim: bright lip, then the dark interior below it
  row(x, y - 11, 11, '#ffffff');
  row(x, y - 10, 14, '#ffffff');
  TUB_INNER.forEach(([dy, hw]) => row(x, y + dy, hw, '#8e9aa6'));   // inner wall
  TUB_INNER.forEach(([dy, hw]) => row(x, y + dy, hw - 2, '#6fb6d8')); // bathwater
  px(x - 9, y - 7, 4, 1, '#d8f0ff'); px(x + 3, y - 5, 5, 1, '#d8f0ff');  // suds
  px(x - 3, y - 4, 3, 1, '#d8f0ff');

  // 4. clawfeet + faucet at the near end, the two details that say "bathtub"
  px(x - 12, y + 7, 4, 4, '#22303e'); px(x - 11, y + 7, 2, 3, '#8d949c');
  px(x + 8,  y + 7, 4, 4, '#22303e'); px(x + 9,  y + 7, 2, 3, '#8d949c');
  px(x - 1, y + 3, 3, 4, '#22303e');            // spout neck
  px(x - 1, y + 3, 2, 3, '#b9c2cb');
  px(x - 3, y + 6, 6, 2, '#22303e');            // spout lip
  px(x - 2, y + 6, 3, 1, '#e8eef4');
  px(x - 6, y + 4, 3, 3, '#22303e'); px(x - 5, y + 5, 1, 1, '#cfd6dd');   // taps
  px(x + 4, y + 4, 3, 3, '#22303e'); px(x + 5, y + 5, 1, 1, '#cfd6dd');

  /* ------------------------- the bridge troll -------------------------
     Heavy brow, deep-set eyes, hooked nose, underbite with tusks, big
     pointed ears. Hair is rooted on the skull so it can't read as horns. */
  const G='#84a862', GD='#54763c', GL='#a3c47e', GX='#44622f', OUT='#22303e';
  const HAIR='#6b5238', HAIR_L='#8a6f4c', HAIR_D='#4a3826';
  const span = (yy, x1, x2, col) => px(x1, yy, x2-x1+1, 1, col);
  // hair lifts in the wind during turbo
  const hlift = State.turbo > 0 ? -Math.abs(Math.sin(State.t*18))*3 : 0;

  // shoulders meet the rim so the head sits clear of the water
  px(x-11, y-15, 23, 6, OUT); px(x-10, y-14, 21, 5, GD); px(x-10, y-14, 21, 1, '#6b9150');
  // head
  px(x-10, y-35, 21, 20, OUT);
  px(x-9,  y-34, 19, 18, G); px(x-9, y-34, 19, 3, GL);
  // ears
  px(x-14, y-29, 5, 10, OUT); px(x-13, y-28, 3, 7, G); px(x-13, y-26, 2, 3, GD);
  px(x+10, y-29, 5, 10, OUT); px(x+11, y-28, 3, 7, G); px(x+11, y-26, 2, 3, GD);
  // heavy brow + the shadow it casts
  px(x-9, y-31, 19, 3, GX); px(x-9, y-28, 19, 1, '#5f8248');
  // eyes, tracking the steering
  const look = clamp(Player.vx / 90, -1, 1);
  px(x-8, y-28, 5, 5, '#ffffff'); px(x+4, y-28, 5, 5, '#ffffff');
  px(x-6+look, y-27, 2, 3, '#12222c'); px(x+5+look, y-27, 2, 3, '#12222c');
  // hooked nose, outlined so it stands off the face
  px(x-3, y-27, 6, 8, OUT);
  px(x-2, y-26, 4, 6, GD); px(x-2, y-26, 2, 2, GL);
  px(x-5, y-21, 9, 4, OUT);
  px(x-4, y-20, 7, 2, GD); px(x-4, y-20, 2, 1, GL); px(x+1, y-20, 2, 1, '#3f5c2c');
  // underbite, corners lifted, tusks over the lip
  px(x-9, y-16, 19, 4, OUT); px(x-8, y-15, 17, 2, '#3a2418');
  px(x-10, y-17, 3, 2, OUT); px(x+8, y-17, 3, 2, OUT);
  px(x-7, y-19, 3, 4, '#ffffff'); px(x+5, y-19, 3, 4, '#ffffff');
  px(x-7, y-19, 3, 1, '#dcdcd4'); px(x+5, y-19, 3, 1, '#dcdcd4');
  px(x-8, y-25, 2, 2, '#6b9150'); px(x+7, y-24, 2, 2, '#6b9150');   // warts
  // coarse tufts either side of a bald crown
  const base = y - 35 + hlift;
  [[0,-9,-3],[-1,-9,-4],[-2,-8,-5],[-3,-7,-6],[0,3,9],[-1,4,9],[-2,5,8],[-3,6,7]]
    .forEach(([dy,a,b]) => span(base+dy, x+a, x+b, HAIR));
  span(base-4, x-7, x-6, HAIR_D); span(base-4, x+6, x+7, HAIR_D);
  span(base-1, x-8, x-7, HAIR_L); span(base-1, x+6, x+7, HAIR_L);
  px(x-12, base+1, 3, 4, HAIR); px(x+10, base+1, 3, 4, HAIR);
  px(x-2, base, 4, 1, HAIR_D);

  // arms: one gripping the rim, one working the net
  px(x-14, y-13, 5, 3, OUT); px(x-13, y-12, 4, 2, G);
  const netUp = air > 0;
  const nx = x + 18, ny = netUp ? y - 26 : y - 13;
  px(x+9, y-15, 7, 3, OUT); px(x+9, y-14, 6, 2, G);
  px(nx-6, ny+4, 2, 3, '#5a3d1e'); px(nx-5, ny+6, 2, 3, '#5a3d1e'); px(nx-4, ny+8, 2, 3, '#7d5228');
  const HOOP = [[-6,3],[-5,4],[-4,5],[-3,6],[-2,6],[-1,5],[0,4],[1,2]];
  HOOP.forEach(([dy,hw2]) => row(nx, ny + dy, hw2 + 1, OUT));
  HOOP.forEach(([dy,hw2]) => row(nx, ny + dy, hw2, '#efeacf'));
  for (let i = -4; i <= 4; i += 3) px(nx + i, ny - 5, 1, 6, '#b9b294');
  px(nx-5, ny-3, 11, 1, '#b9b294'); px(nx-5, ny-1, 11, 1, '#b9b294');
  row(nx, ny - 6, 3, '#cfd6dd');
  g.restore();
}

/* Every floating object gets a dark outline, a shadow, and a colour-coded ring.
   The ring is the clearest signal in the game: green = grab it, red = avoid it. */
function outline(x,y,w,h,col){ px(x-1, y-1, w+2, h+2, col || '#16323f'); }
function waterShadow(x,y,w){
  g.globalAlpha = 0.20; px(x - w/2, y + 3, w, 3, '#123a4d'); g.globalAlpha = 1;
}
function marker(x, y, w, kind){
  const col = kind === 'good' ? '#7ef2a0' : kind === 'time' ? '#7fd3f2' : kind === 'rare' ? '#ffd97a'
            : kind === 'ramp' ? '#ffe08a' : '#ff6b6e';
  const hw = Math.max(9, (w/2 + 3)|0);
  g.globalAlpha = 0.9;
  px(x-hw, y+5, hw*2, 2, col);
  px(x-hw, y+2, 2, 3, col);
  px(x+hw-2, y+2, 2, 3, col);
  g.globalAlpha = 1;
}

function drawEntity(e){
  const x = e.x|0, y = e.y|0;
  waterShadow(x, y + e.h/2, e.w);
  marker(x, y + e.h/2, e.w,
    e.type === 'trash' ? 'good' :
    e.type === 'ball' ? 'time' :
    (e.type === 'button' || e.type === 'boost') ? 'rare' :
    e.type === 'ramp' ? 'ramp' : 'bad');

  if (e.type === 'trash'){
    g.save(); g.translate(x,y); g.rotate(Math.sin((State.t+e.t)*2)*0.14*e.spin); g.translate(-x,-y);
    if (e.kind === 'can'){
      outline(x-5,y-6,11,13); px(x-5,y-6,11,13,'#d6d9df');
      px(x-5,y-6,11,3,'#9aa0a8'); px(x-5,y-1,11,3,'#dc5b5e'); px(x-5,y+4,11,3,'#9aa0a8');
    }
    if (e.kind === 'bottle'){
      outline(x-4,y-7,9,15); px(x-4,y-7,9,15,'#6fc46a');
      px(x-2,y-10,5,4,'#4f9f4a'); outline(x-2,y-10,5,4,'#16323f');
      px(x-4,y-1,9,4,'#a8e6a3');
    }
    if (e.kind === 'cup'){
      outline(x-6,y-7,13,15); px(x-6,y-7,13,15,'#f6f6f0');
      px(x-6,y-7,13,4,'#dc5b5e'); px(x-2,y-11,4,4,'#c9ccd2'); outline(x-2,y-11,4,4,'#16323f');
    }
    if (e.kind === 'boot'){
      // shaft
      outline(x-7,y-8,9,10); px(x-7,y-8,9,10,'#8a6040');
      px(x-7,y-8,9,2,'#a87a52');                    // cuff
      px(x-5,y-4,2,1,'#e8d9a8'); px(x-5,y-1,2,1,'#e8d9a8');   // laces
      // foot, pointing right
      outline(x-7,y+2,15,4); px(x-7,y+2,15,4,'#7d5636');
      // sole + heel, the bits that say 'boot'
      outline(x-8,y+6,17,3); px(x-8,y+6,17,3,'#33251a');
      px(x-8,y+5,4,4,'#33251a');                    // heel block
      px(x+5,y+5,3,2,'#5a3d24');                    // toe cap
    }
    if (e.kind === 'tire'){
      // circular silhouette rather than a square block
      const T = [[-8,4],[-7,6],[-6,7],[-5,8],[-4,8],[-3,8],[-2,8],[-1,8],[0,8],
                 [1,8],[2,8],[3,8],[4,8],[5,7],[6,6],[7,4]];
      T.forEach(([dy,hw]) => px(x-hw-1, y+dy, (hw+1)*2, 1, '#16323f'));
      T.forEach(([dy,hw]) => px(x-hw,   y+dy,  hw*2,    1, '#33373d'));
      // hub
      px(x-4,y-4,8,8,'#8f959d'); px(x-3,y-3,6,6,'#5c626b'); px(x-1,y-1,2,2,'#2b2f35');
      // tread notches around the rim
      px(x-8,y-2,2,4,'#5a5f66'); px(x+6,y-2,2,4,'#5a5f66');
      px(x-2,y-8,4,2,'#5a5f66'); px(x-2,y+6,4,2,'#5a5f66');
    }
    if (e.kind === 'bag'){
      const p = (Math.sin(State.t*9)+1)/2;
      outline(x-8,y-8,16,16,'#6b4f0d'); px(x-8,y-8,16,16,'#f0c53f');
